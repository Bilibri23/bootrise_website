# Required for waitlist (Resend)
RESEND_API_KEY=re_xxxxxxxx
WAITLIST_TO_EMAIL=you@example.com

# Recommended: use a verified domain sender in production
# Example: BootRise <hello@bootrise.com>
WAITLIST_FROM_EMAIL=BootRise <onboarding@resend.dev>

# Optional: Loom share or embed URL (set when video is ready)
# Examples:
# NEXT_PUBLIC_DEMO_VIDEO_URL=https://www.loom.com/share/abc123
# NEXT_PUBLIC_DEMO_VIDEO_URL=https://www.loom.com/embed/abc123
NEXT_PUBLIC_DEMO_VIDEO_URL=
